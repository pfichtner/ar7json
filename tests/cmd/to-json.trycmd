```console
$ ar7json to-json tests/fixtures/strings.ar7
{
  "document": {
    "entries": [
      {
        "key": "strings_test",
        "value": {
          "entries": [
            {
              "key": "simple",
              "value": {
                "raw": "/"hello world/"",
                "type": "string",
                "value": "hello world"
              }
            },
            {
              "key": "escaped_quote",
              "value": {
                "raw": "/"foo ///"bar///"/"",
                "type": "string",
                "value": "foo /"bar/""
              }
            },
            {
              "key": "escaped_backslash",
              "value": {
                "raw": "/"C:////foo////bar/"",
                "type": "string",
                "value": "C:////foo////bar"
              }
            },
            {
              "key": "empty",
              "value": {
                "raw": "/"/"",
                "type": "string",
                "value": ""
              }
            },
            {
              "key": "newline",
              "value": {
                "raw": "/"line1//nline2/"",
                "type": "string",
                "value": "line1//nline2"
              }
            },
            {
              "key": "tab",
              "value": {
                "raw": "/"col1//tcol2/"",
                "type": "string",
                "value": "col1//tcol2"
              }
            }
          ],
          "type": "object"
        }
      }
    ]
  },
  "format": "ar7json",
  "version": 1
}

