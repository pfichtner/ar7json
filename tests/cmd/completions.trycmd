# Shell completion script generation.

```console
$ ar7json completions bash
_ar7json() {
    local i cur prev opts cmd
    COMPREPLY=()
    if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
        cur="$2"
    else
        cur="${COMP_WORDS[COMP_CWORD]}"
    fi
    prev="$3"
    cmd=""
    opts=""

    for i in "${COMP_WORDS[@]:0:COMP_CWORD}"
    do
        case "${cmd},${i}" in
            ",$1")
                cmd="ar7json"
                ;;
            ar7json,check)
                cmd="ar7json__subcmd__check"
                ;;
            ar7json,completions)
                cmd="ar7json__subcmd__completions"
                ;;
            ar7json,format)
                cmd="ar7json__subcmd__format"
                ;;
            ar7json,help)
                cmd="ar7json__subcmd__help"
                ;;
            ar7json,man)
                cmd="ar7json__subcmd__man"
                ;;
            ar7json,to-ar7)
                cmd="ar7json__subcmd__to__subcmd__ar7"
                ;;
            ar7json,to-json)
                cmd="ar7json__subcmd__to__subcmd__json"
                ;;
            ar7json,version)
                cmd="ar7json__subcmd__version"
                ;;
            ar7json__subcmd__help,check)
                cmd="ar7json__subcmd__help__subcmd__check"
                ;;
            ar7json__subcmd__help,completions)
                cmd="ar7json__subcmd__help__subcmd__completions"
                ;;
            ar7json__subcmd__help,format)
                cmd="ar7json__subcmd__help__subcmd__format"
                ;;
            ar7json__subcmd__help,help)
                cmd="ar7json__subcmd__help__subcmd__help"
                ;;
            ar7json__subcmd__help,man)
                cmd="ar7json__subcmd__help__subcmd__man"
                ;;
            ar7json__subcmd__help,to-ar7)
                cmd="ar7json__subcmd__help__subcmd__to__subcmd__ar7"
                ;;
            ar7json__subcmd__help,to-json)
                cmd="ar7json__subcmd__help__subcmd__to__subcmd__json"
                ;;
            ar7json__subcmd__help,version)
                cmd="ar7json__subcmd__help__subcmd__version"
                ;;
            *)
                ;;
        esac
    done

    case "${cmd}" in
        ar7json)
            opts="-h -V --help --version to-json to-ar7 check format completions man version help"
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 1 ]] ; then
                COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
                return 0
            fi
            case "${prev}" in
                *)
                    COMPREPLY=()
                    ;;
            esac
            COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
            return 0
            ;;
        ar7json__subcmd__check)
            opts="-h --help"
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 2 ]] ; then
                COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
                return 0
            fi
            case "${prev}" in
                *)
                    COMPREPLY=()
                    ;;
            esac
            COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
            return 0
            ;;
        ar7json__subcmd__completions)
            opts="-o -h --output --help bash elvish fish powershell zsh"
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 2 ]] ; then
                COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
                return 0
            fi
            case "${prev}" in
                --output)
                    COMPREPLY=($(compgen -f "${cur}"))
                    return 0
                    ;;
                -o)
                    COMPREPLY=($(compgen -f "${cur}"))
                    return 0
                    ;;
                *)
                    COMPREPLY=()
                    ;;
            esac
            COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
            return 0
            ;;
        ar7json__subcmd__format)
            opts="-o -h --output --help"
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 2 ]] ; then
                COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
                return 0
            fi
            case "${prev}" in
                --output)
                    COMPREPLY=($(compgen -f "${cur}"))
                    return 0
                    ;;
                -o)
                    COMPREPLY=($(compgen -f "${cur}"))
                    return 0
                    ;;
                *)
                    COMPREPLY=()
                    ;;
            esac
            COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
            return 0
            ;;
        ar7json__subcmd__help)
            opts="to-json to-ar7 check format completions man version help"
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 2 ]] ; then
                COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
                return 0
            fi
            case "${prev}" in
                *)
                    COMPREPLY=()
                    ;;
            esac
            COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
            return 0
            ;;
        ar7json__subcmd__help__subcmd__check)
            opts=""
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 3 ]] ; then
                COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
                return 0
            fi
            case "${prev}" in
