if [[ "${BASH_VERSINFO[0]}" -eq 4 && "${BASH_VERSINFO[1]}" -ge 4 || "${BASH_VERSINFO[0]}" -gt 4 ]]; then
    complete -F _ar7json -o nosort -o bashdefault -o default ar7json
else
    complete -F _ar7json -o bashdefault -o default ar7json
fi

