```console
$ ar7json completions zsh
#compdef ar7json

autoload -U is-at-least

_ar7json() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : /
'-h[Print help]' /
'--help[Print help]' /
'-V[Print version]' /
'--version[Print version]' /
":: :_ar7json_commands" /
"*::: :->ar7json" /
&& ret=0
    case $state in
    (ar7json)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:ar7json-command-$line[1]:"
        case $line[1] in
            (to-json)
_arguments "${_arguments_options[@]}" : /
'-o+[Output file (writes to stdout if omitted)]:OUTPUT:_files' /
'--output=[Output file (writes to stdout if omitted)]:OUTPUT:_files' /
'--simple[Use simplified JSON representation (lossy, read-only)]' /
'-h[Print help]' /
'--help[Print help]' /
'::input -- Input file (reads stdin if omitted):_files' /
&& ret=0
;;
(to-ar7)
_arguments "${_arguments_options[@]}" : /
'-o+[Output file (writes to stdout if omitted)]:OUTPUT:_files' /
'--output=[Output file (writes to stdout if omitted)]:OUTPUT:_files' /
'-h[Print help]' /
'--help[Print help]' /
'::input -- Input JSON file (reads stdin if omitted):_files' /
&& ret=0
;;
(check)
_arguments "${_arguments_options[@]}" : /
'-h[Print help]' /
'--help[Print help]' /
'::input -- Input file (reads stdin if omitted):_files' /
&& ret=0
;;
(format)
_arguments "${_arguments_options[@]}" : /
'-o+[Output file (writes to stdout if omitted)]:OUTPUT:_files' /
'--output=[Output file (writes to stdout if omitted)]:OUTPUT:_files' /
'-h[Print help]' /
'--help[Print help]' /
'::input -- Input file (reads stdin if omitted):_files' /
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : /
'-o+[Output file (writes to stdout if omitted)]:OUTPUT:_files' /
'--output=[Output file (writes to stdout if omitted)]:OUTPUT:_files' /
'-h[Print help]' /
'--help[Print help]' /
':shell -- Shell to generate completions for:(bash elvish fish powershell zsh)' /
&& ret=0
;;
(man)
_arguments "${_arguments_options[@]}" : /
'-o+[Output file (writes to stdout if omitted)]:OUTPUT:_files' /
'--output=[Output file (writes to stdout if omitted)]:OUTPUT:_files' /
'-h[Print help]' /
'--help[Print help]' /
&& ret=0
;;
(version)
_arguments "${_arguments_options[@]}" : /
'-h[Print help]' /
'--help[Print help]' /
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : /
":: :_ar7json__subcmd__help_commands" /
"*::: :->help" /
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:ar7json-help-command-$line[1]:"
        case $line[1] in
            (to-json)
_arguments "${_arguments_options[@]}" : /
&& ret=0
;;
(to-ar7)
_arguments "${_arguments_options[@]}" : /
&& ret=0
;;
(check)
_arguments "${_arguments_options[@]}" : /
&& ret=0
;;
(format)
_arguments "${_arguments_options[@]}" : /
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : /
&& ret=0
;;
(man)
_arguments "${_arguments_options[@]}" : /
&& ret=0
;;
(version)
_arguments "${_arguments_options[@]}" : /
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : /
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_ar7json_commands] )) ||
_ar7json_commands() {
    local commands; commands=(
'to-json:Convert AR7 configuration to JSON' /
'to-ar7:Convert JSON back to AR7 configuration' /
'check:Check AR7 configuration for syntax errors' /
'format:Format AR7 configuration with canonical formatting' /
'completions:Generate shell completion scripts' /
'man:Generate man page' /
'version:Show version information' /
'help:Print this message or the help of the given subcommand(s)' /
    )
    _describe -t commands 'ar7json commands' commands "$@"
}
(( $+functions[_ar7json__subcmd__check_commands] )) ||
_ar7json__subcmd__check_commands() {
    local commands; commands=()
    _describe -t commands 'ar7json check commands' commands "$@"
}
(( $+functions[_ar7json__subcmd__completions_commands] )) ||
_ar7json__subcmd__completions_commands() {
    local commands; commands=()
    _describe -t commands 'ar7json completions commands' commands "$@"
}
(( $+functions[_ar7json__subcmd__format_commands] )) ||
_ar7json__subcmd__format_commands() {
    local commands; commands=()
    _describe -t commands 'ar7json format commands' commands "$@"
}
(( $+functions[_ar7json__subcmd__help_commands] )) ||
_ar7json__subcmd__help_commands() {
    local commands; commands=(
'to-json:Convert AR7 configuration to JSON' /
'to-ar7:Convert JSON back to AR7 configuration' /
'check:Check AR7 configuration for syntax errors' /
'format:Format AR7 configuration with canonical formatting' /
'completions:Generate shell completion scripts' /
'man:Generate man page' /
'version:Show version information' /
'help:Print this message or the help of the given subcommand(s)' /
    )
    _describe -t commands 'ar7json help commands' commands "$@"
}
(( $+functions[_ar7json__subcmd__help__subcmd__check_commands] )) ||
_ar7json__subcmd__help__subcmd__check_commands() {
    local commands; commands=()
    _describe -t commands 'ar7json help check commands' commands "$@"
}
(( $+functions[_ar7json__subcmd__help__subcmd__completions_commands] )) ||
_ar7json__subcmd__help__subcmd__completions_commands() {
    local commands; commands=()
    _describe -t commands 'ar7json help completions commands' commands "$@"
}
(( $+functions[_ar7json__subcmd__help__subcmd__format_commands] )) ||
_ar7json__subcmd__help__subcmd__format_commands() {
    local commands; commands=()
    _describe -t commands 'ar7json help format commands' commands "$@"
}
(( $+functions[_ar7json__subcmd__help__subcmd__help_commands] )) ||
_ar7json__subcmd__help__subcmd__help_commands() {
    local commands; commands=()
    _describe -t commands 'ar7json help help commands' commands "$@"
}
(( $+functions[_ar7json__subcmd__help__subcmd__man_commands] )) ||
_ar7json__subcmd__help__subcmd__man_commands() {
    local commands; commands=()
    _describe -t commands 'ar7json help man commands' commands "$@"
}
(( $+functions[_ar7json__subcmd__help__subcmd__to-ar7_commands] )) ||
_ar7json__subcmd__help__subcmd__to-ar7_commands() {
    local commands; commands=()
    _describe -t commands 'ar7json help to-ar7 commands' commands "$@"
}
(( $+functions[_ar7json__subcmd__help__subcmd__to-json_commands] )) ||
_ar7json__subcmd__help__subcmd__to-json_commands() {
    local commands; commands=()
    _describe -t commands 'ar7json help to-json commands' commands "$@"
}
(( $+functions[_ar7json__subcmd__help__subcmd__version_commands] )) ||
_ar7json__subcmd__help__subcmd__version_commands() {
    local commands; commands=()
    _describe -t commands 'ar7json help version commands' commands "$@"
}
(( $+functions[_ar7json__subcmd__man_commands] )) ||
_ar7json__subcmd__man_commands() {
    local commands; commands=()
    _describe -t commands 'ar7json man commands' commands "$@"
}
(( $+functions[_ar7json__subcmd__to-ar7_commands] )) ||
_ar7json__subcmd__to-ar7_commands() {
    local commands; commands=()
    _describe -t commands 'ar7json to-ar7 commands' commands "$@"
}
(( $+functions[_ar7json__subcmd__to-json_commands] )) ||
_ar7json__subcmd__to-json_commands() {
    local commands; commands=()
    _describe -t commands 'ar7json to-json commands' commands "$@"
}
(( $+functions[_ar7json__subcmd__version_commands] )) ||
_ar7json__subcmd__version_commands() {
    local commands; commands=()
    _describe -t commands 'ar7json version commands' commands "$@"
}

if [ "$funcstack[1]" = "_ar7json" ]; then
    _ar7json "$@"
else
    compdef _ar7json ar7json
fi

