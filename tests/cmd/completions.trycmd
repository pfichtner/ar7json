```console
$ ar7json completions elvish

use builtin;
use str;

set edit:completion:arg-completer[ar7json] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'ar7json'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'ar7json'= {
            cand -h 'Print help'
            cand --help 'Print help'
            cand -V 'Print version'
            cand --version 'Print version'
            cand to-json 'Convert AR7 configuration to JSON'
            cand to-ar7 'Convert JSON back to AR7 configuration'
            cand check 'Check AR7 configuration for syntax errors'
            cand format 'Format AR7 configuration with canonical formatting'
            cand completions 'Generate shell completion scripts'
            cand man 'Generate man page'
            cand version 'Show version information'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'ar7json;to-json'= {
            cand -o 'Output file (writes to stdout if omitted)'
            cand --output 'Output file (writes to stdout if omitted)'
            cand --simple 'Use simplified JSON representation (lossy, read-only)'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'ar7json;to-ar7'= {
            cand -o 'Output file (writes to stdout if omitted)'
            cand --output 'Output file (writes to stdout if omitted)'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'ar7json;check'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'ar7json;format'= {
            cand -o 'Output file (writes to stdout if omitted)'
            cand --output 'Output file (writes to stdout if omitted)'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'ar7json;completions'= {
            cand -o 'Output file (writes to stdout if omitted)'
            cand --output 'Output file (writes to stdout if omitted)'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'ar7json;man'= {
            cand -o 'Output file (writes to stdout if omitted)'
            cand --output 'Output file (writes to stdout if omitted)'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'ar7json;version'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'ar7json;help'= {
            cand to-json 'Convert AR7 configuration to JSON'
            cand to-ar7 'Convert JSON back to AR7 configuration'
            cand check 'Check AR7 configuration for syntax errors'
            cand format 'Format AR7 configuration with canonical formatting'
            cand completions 'Generate shell completion scripts'
            cand man 'Generate man page'
            cand version 'Show version information'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'ar7json;help;to-json'= {
        }
        &'ar7json;help;to-ar7'= {
        }
        &'ar7json;help;check'= {
        }
        &'ar7json;help;format'= {
        }
        &'ar7json;help;completions'= {
        }
        &'ar7json;help;man'= {
        }
        &'ar7json;help;version'= {
        }
        &'ar7json;help;help'= {
        }
    ]
    $completions[$command]
}

