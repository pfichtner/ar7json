```console
$ ar7json completions fish
# Print an optspec for argparse to handle cmd's options that are independent of any subcommand.
function __fish_ar7json_global_optspecs
    string join /n h/help V/version
end

function __fish_ar7json_needs_command
    # Figure out if the current invocation already has a command.
    set -l cmd (commandline -opc)
    set -e cmd[1]
    argparse -s (__fish_ar7json_global_optspecs) -- $cmd 2>/dev/null
    or return
    if set -q argv[1]
        # Also print the command, so this can be used to figure out what it is.
        echo $argv[1]
        return 1
    end
    return 0
end

function __fish_ar7json_using_subcommand
    set -l cmd (__fish_ar7json_needs_command)
    test -z "$cmd"
    and return 1
    contains -- $cmd[1] $argv
end

complete -c ar7json -n "__fish_ar7json_needs_command" -s h -l help -d 'Print help'
complete -c ar7json -n "__fish_ar7json_needs_command" -s V -l version -d 'Print version'
complete -c ar7json -n "__fish_ar7json_needs_command" -f -a "to-json" -d 'Convert AR7 configuration to JSON'
complete -c ar7json -n "__fish_ar7json_needs_command" -f -a "to-ar7" -d 'Convert JSON back to AR7 configuration'
complete -c ar7json -n "__fish_ar7json_needs_command" -f -a "check" -d 'Check AR7 configuration for syntax errors'
complete -c ar7json -n "__fish_ar7json_needs_command" -f -a "format" -d 'Format AR7 configuration with canonical formatting'
complete -c ar7json -n "__fish_ar7json_needs_command" -f -a "completions" -d 'Generate shell completion scripts'
complete -c ar7json -n "__fish_ar7json_needs_command" -f -a "man" -d 'Generate man page'
complete -c ar7json -n "__fish_ar7json_needs_command" -f -a "version" -d 'Show version information'
complete -c ar7json -n "__fish_ar7json_needs_command" -f -a "help" -d 'Print this message or the help of the given subcommand(s)'
complete -c ar7json -n "__fish_ar7json_using_subcommand to-json" -s o -l output -d 'Output file (writes to stdout if omitted)' -r -F
complete -c ar7json -n "__fish_ar7json_using_subcommand to-json" -l simple -d 'Use simplified JSON representation (lossy, read-only)'
complete -c ar7json -n "__fish_ar7json_using_subcommand to-json" -s h -l help -d 'Print help'
complete -c ar7json -n "__fish_ar7json_using_subcommand to-ar7" -s o -l output -d 'Output file (writes to stdout if omitted)' -r -F
complete -c ar7json -n "__fish_ar7json_using_subcommand to-ar7" -s h -l help -d 'Print help'
complete -c ar7json -n "__fish_ar7json_using_subcommand check" -s h -l help -d 'Print help'
complete -c ar7json -n "__fish_ar7json_using_subcommand format" -s o -l output -d 'Output file (writes to stdout if omitted)' -r -F
complete -c ar7json -n "__fish_ar7json_using_subcommand format" -s h -l help -d 'Print help'
complete -c ar7json -n "__fish_ar7json_using_subcommand completions" -s o -l output -d 'Output file (writes to stdout if omitted)' -r -F
complete -c ar7json -n "__fish_ar7json_using_subcommand completions" -s h -l help -d 'Print help'
complete -c ar7json -n "__fish_ar7json_using_subcommand man" -s o -l output -d 'Output file (writes to stdout if omitted)' -r -F
complete -c ar7json -n "__fish_ar7json_using_subcommand man" -s h -l help -d 'Print help'
complete -c ar7json -n "__fish_ar7json_using_subcommand version" -s h -l help -d 'Print help'
complete -c ar7json -n "__fish_ar7json_using_subcommand help; and not __fish_seen_subcommand_from to-json to-ar7 check format completions man version help" -f -a "to-json" -d 'Convert AR7 configuration to JSON'
complete -c ar7json -n "__fish_ar7json_using_subcommand help; and not __fish_seen_subcommand_from to-json to-ar7 check format completions man version help" -f -a "to-ar7" -d 'Convert JSON back to AR7 configuration'
complete -c ar7json -n "__fish_ar7json_using_subcommand help; and not __fish_seen_subcommand_from to-json to-ar7 check format completions man version help" -f -a "check" -d 'Check AR7 configuration for syntax errors'
complete -c ar7json -n "__fish_ar7json_using_subcommand help; and not __fish_seen_subcommand_from to-json to-ar7 check format completions man version help" -f -a "format" -d 'Format AR7 configuration with canonical formatting'
complete -c ar7json -n "__fish_ar7json_using_subcommand help; and not __fish_seen_subcommand_from to-json to-ar7 check format completions man version help" -f -a "completions" -d 'Generate shell completion scripts'
