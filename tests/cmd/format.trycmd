future_config {
    new_option = new_value;
    another = 42;
    flag = yes;
}

```

```console
$ ar7json format tests/fixtures/real-world/real04.ar7
complex {
    duplicate = 1;
    duplicate = 2;
    duplicate = "three";
    numbers {
        int_val = 42;
        neg_val = -7;
        float_val = 3.14;
        zero = 0;
        leading_zero = 001;
    }
    addrs {
        ip = 192.168.178.1;
        ip2 = 10.0.0.1;
    }
    lists {
        empty_list = ;
        one_item = "only";
        two_items = "a", "b";
    }
}

```

```console
$ ar7json format tests/fixtures/real-world/real05.ar7
edge_cases {
    empty_string = "";
    single_char = "x";
    negative_int = -42;
    zero = 0;
    large_int = 999999;
    ip_addr = 192.168.178.1;
    ip_loopback = 127.0.0.1;
    floating = 3.14;
    neg_float = -0.5;
    duration_ms = 500ms;
    duration_sec = 30s;
    duration_min = 5m;
    duration_hour = 2h;
    duration_day = 7d;
    bool_yes = yes;
    bool_no = no;
    dotted_ident = foo.bar.baz;
    hyphen_ident = foo-bar;
    colon_ident = ab:cd:ef:01:23:45;
    empty_block {
    }
    nested_deep {
        a {
            b {
                c {
                    d = 1;
                }
            }
        }
    }
}

```
