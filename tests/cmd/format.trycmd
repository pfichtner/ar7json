# Byte-exact goldens for `format` over all fixtures.

```console
$ ar7json format tests/fixtures/minimal.ar7
meta {
    encoding = "utf-8";
}

```

```console
$ ar7json format tests/fixtures/nested.ar7
meta {
    encoding = "utf-8";
}
ar7cfg {
    mode = dsldmode_router;
    active_provider = "other";
    active_name = "";
    igddenabled = yes;
    mtu_cutback = 1500;
    hsi_vlancfg {
        vlanid = 0;
        vlanprio = 0;
    }
    serialcfg {
        number = "*99#";
        inactivity_timeout = 1m;
        backup {
            enabled = no;
            downtime = 3m;
            reverttime = 30m;
        }
    }
}

```

```console
$ ar7json format tests/fixtures/strings.ar7
strings_test {
    simple = "hello world";
    escaped_quote = "foo /"bar/"";
    escaped_backslash = "C://foo//bar";
    empty = "";
    newline = "line1/nline2";
    tab = "col1/tcol2";
}

```

```console
$ ar7json format tests/fixtures/lists.ar7
lists_test {
    single = "only";
    short = "a", "b", "c";
    integers = 1, 2, 3;
    mixed = "text", 42, yes;
}

```

```console
$ ar7json format tests/fixtures/durations.ar7
durations_test {
    milliseconds = 500ms;
    seconds = 30s;
    minutes = 5m;
    hours = 2h;
    days = 7d;
}

```

```console
$ ar7json format tests/fixtures/real-world/real01.ar7
/*
 * /var/tmp.cfg
 * Thu Jan 1 01:05:57 1970
 */
meta {
    encoding = "utf-8";
}
ar7cfg {
    // Configuration mode
    mode = dsldmode_router;
    active_provider = "tonline";
    active_name = "";
    igddenabled = no;
    wan_bridge_with_dhcpc = yes;
    wan_bridge_gateway = 0.0.0.0;
    hsi_vlancfg {
        vlanencap = vlanencap_none;
        tagtype = vlantagtype_customer;
        vlanid = 0;
        vlanprio = 0;
        tos = 0;
    }
    serialcfg {
        mode = serialmode_off;
        number = "*99#";
        inactivity_timeout = 1m;
        backup {
            enabled = no;
            quickstart = serialquickstart_off;
            downtime = 3m;
            reverttime = 30m;
        }
    }
}

```

